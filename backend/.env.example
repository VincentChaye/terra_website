# Copier vers .env (jamais commité) et renseigner les valeurs réelles.

PORT=3001
# Origine exacte du frontend (nginx), sans le chemin. Ex. https://terra-numerica.org
FRONTEND_ORIGIN=

# ─── Wimi (agenda) ───
WIMI_APP_TOKEN=
WIMI_SPACE_ID=
WIMI_ACCOUNT_NAME=
WIMI_LOGIN=
WIMI_PASSWORD=

# ─── Resend (formulaires) ───
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
