# Frontend statique (SPA Vue 3 + Vite, build dans frontend/out). Le backend Fastify est un service
# séparé, sur une autre origine/port (voir tn-backend.service) — les appels
# depuis le frontend passent par CORS (FRONTEND_ORIGIN côté backend).
#
# root pointe sur le symlink `current` (pas directement sur un dossier de
# build) : scripts/deploy-frontend.sh construit chaque déploiement dans un
# dossier horodaté puis ne bascule ce symlink qu'une fois le build validé —
# nginx ne sert donc jamais un build à moitié écrit.

server {
    listen 80;
    server_name terra-numerica.example;

    root /opt/tn-site/frontend/current;
    index index.html;

    # SPA en mode history : toute URL inconnue retombe sur index.html (le routeur
    # Vue affiche la page ou la 404). Les assets hachés de /assets sont immuables.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
